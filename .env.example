# ---------------------------------------------------------------------------
# Admin dashboard configuration
# Copy to `.env.local` for development.
# ---------------------------------------------------------------------------

# Origin of the people-pow v5 API.
API_SERVER_URL=https://people-powapi-v5-5ifxz.ondigitalocean.app

# Shared secret for the admin governance API. MUST match ADMIN_API_KEY on the
# backend.
#
# ⚠️ SERVER-ONLY. Never rename this to NEXT_PUBLIC_ADMIN_API_KEY — that would
# ship the key to every browser and let anyone call the admin API directly.
# It is read exclusively inside src/pages/api/admin/* handlers.
#
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=replace-me-with-a-64-char-random-hex-string
